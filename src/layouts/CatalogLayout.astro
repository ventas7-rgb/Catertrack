---
// Shared shell for every catalog page (home, category, subcategory, product).
// Previously this header/nav/footer/scripts markup was copy-pasted into all
// four page files (~150 lines each). Centralizing it here means a fix only
// has to happen once, and every page automatically gets it.
import { categorias } from '../data/catalogo';
import { base, landingBase } from '../utils/base';

interface Props {
  title: string;
  description?: string;
  activeCategoria?: string;
}

const { title, description, activeCategoria } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href={`${base}css/catalog.css`} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>

    <div class="header__contact" aria-label="Información de contacto">
      <a class="header__contact-item" href="https://wa.me/573132416739" target="_blank" rel="noopener noreferrer">
        <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
        <strong>Línea móvil y WhatsApp: 313 241 6739</strong>
      </a>
      <a class="header__contact-item" href="mailto:ventas7@catekomsas.com">
        <i class="fas fa-envelope" aria-hidden="true"></i>
        <strong>ventas7@catekomsas.com</strong>
      </a>
    </div>

    <header class="header">
      <div class="container">
        <nav class="navbar navbar-expand-lg align-items-center" aria-label="Navegación principal">
          <a class="navbar-brand header__logo" href={`${landingBase}#inicio`} aria-label="CaterTrack inicio">
            <img src={`${base}assets/images/foot.webp`} alt="CaterTrack logo" class="header__logo-image" />
          </a>
          <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Abrir menú"
          >
            <span></span><span></span><span></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav header__menu">
              <li class="nav-item"><a class="nav-link" href={`${landingBase}#inicio`}>Inicio</a></li>
              <li class="nav-item"><a class="nav-link" href={`${landingBase}#novedades`}>Novedades</a></li>
              <li class="nav-item"><a class="nav-link" href={`${landingBase}#productos`}>Repuestos Maquinaria Pesada</a></li>
              <li class="nav-item"><a class="nav-link" href={`${landingBase}#sucursales`}>Sucursales</a></li>
              <li class="nav-item"><a class="nav-link" href={`${landingBase}#distribuciones`}>Distribuciones</a></li>
              <li class="nav-item"><a class="nav-link" href={`${landingBase}#nosotros`}>Nosotros</a></li>
              <li class="nav-item"><a class="nav-link" href={`${landingBase}#trabaja`}>Contacto</a></li>
            </ul>
          </div>
        </nav>
      </div>
    </header>

    <nav class="catalog-navigation" aria-label="Categorías del catálogo">
      <div class="container">
        <ul>
          {categorias.map((item) => (
            <li>
              <a href={`${base}${item.slug}`} aria-current={item.slug === activeCategoria ? 'page' : undefined}>
                {item.nombre}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <slot />

    <footer class="footer" id="footer">
      <div class="container footer-grid">
        <div class="footer-branding">
          <div class="footer__brand">
            <img src={`${base}assets/images/foot.webp`} alt="CaterTrack logo" class="footer__logo-image" />
          </div>
          <p>Especialistas en repuestos para maquinaria pesada, con soluciones rápidas y asesoría técnica especializada.</p>
        </div>

        <div class="footer-column">
          <h3>Contacto</h3>
          <ul>
            <li><a href="mailto:recursoshumanos@catekomsas.com"><i class="fa-regular fa-envelope"></i> recursoshumanos@catekomsas.com</a></li>
            <li><a href="mailto:compras@catekomsas.com"><i class="fa-regular fa-envelope"></i> compras@catekomsas.com</a></li>
            <li><a href="mailto:cartera@catekomsas.com"><i class="fa-regular fa-envelope"></i> cartera@catekomsas.com</a></li>
            <li><a href="mailto:ventas7@catekomsas.com"><i class="fa-regular fa-envelope"></i> ventas7@catekomsas.com</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h3>Redes</h3>
          <ul>
            <li><a href="#"><i class="fa-brands fa-linkedin-in"></i> LinkedIn</a></li>
            <li><a href="#"><i class="fa-brands fa-instagram"></i> Instagram</a></li>
            <li><a href="#"><i class="fa-brands fa-facebook-f"></i> Facebook</a></li>
            <li><a href="#"><i class="fa-brands fa-tiktok"></i> TikTok</a></li>
          </ul>
        </div>

        <div class="footer-column footer-column--cta">
          <h3>Trabaja con nosotros</h3>
          <p>¿Quieres formar parte de nuestro equipo?</p>
          <a href="#" class="footer__cta">Enviar hoja de vida</a>
        </div>
      </div>

      <div class="footer__bottom">
        <p>© 2026 CaterTrack. Todos los derechos reservados.</p>
      </div>
    </footer>

    <a class="back-to-top" href="#top" aria-label="Volver arriba"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></a>
    <a class="whatsapp-float" href="https://wa.me/573132416739" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
      <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
    </a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      const backToTopButton = document.querySelector('.back-to-top');
      const toggleBackToTop = () => {
        if (!backToTopButton) return;
        backToTopButton.classList.toggle('is-visible', window.scrollY > 220);
      };
      window.addEventListener('scroll', toggleBackToTop, { passive: true });
      toggleBackToTop();
    </script>
    <slot name="scripts" />
  </body>
</html>
