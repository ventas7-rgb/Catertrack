---
import CatalogLayout from '../../../layouts/CatalogLayout.astro';
import SubcategoryFilters from '../../../components/SubcategoryFilters.astro';
import MachineSearch from '../../../components/MachineSearch.astro';
import { categorias, productos } from '../../../data/catalogo';
import { base } from '../../../utils/base';

export function getStaticPaths() {
  return categorias.flatMap((categoria) =>
    categoria.subcategorias.map((subcategoria) => ({
      params: {
        categoria: categoria.slug,
        subcategoria: subcategoria.slug,
      },
    }))
  );
}

const { categoria, subcategoria } = Astro.params;
const categoriaData = categorias.find((item) => item.slug === categoria);
const subcategoriaData = categoriaData?.subcategorias.find((item) => item.slug === subcategoria);
const items = productos.filter(
  (producto) => producto.categoria === categoria && producto.subcategoria === subcategoria
);

// Ver el comentario equivalente en src/pages/[categoria]/index.astro: solo se
// renderizan de una las primeras PAGE_SIZE tarjetas como HTML real; el resto
// se entrega como datos para que machine-filter.js las cargue bajo demanda y
// para que el buscador siga alcanzando toda la subcategoría.
const PAGE_SIZE = 24;
---

<CatalogLayout title={`${subcategoriaData?.nombre ?? subcategoria} | CaterTrack`} activeCategoria={categoria}>
  <main id="main-content" aria-label="Contenido principal">
    <section class="catalog-products">
      <div class="container">
        <div class="catalog-section-heading">
          <h2>{subcategoriaData?.nombre ?? subcategoria}</h2>
          <span class="catalog-result">{items.length} resultados</span>
        </div>

        {categoriaData && <SubcategoryFilters categoriaSlug={categoria} subcategorias={categoriaData.subcategorias} activeSlug={subcategoria} />}

        <MachineSearch tipo={categoriaData?.buscarPor ?? 'maquina'} />

        <div id="product-grid" class="product-grid" data-base={base} data-page-size={PAGE_SIZE}>
          {items.slice(0, PAGE_SIZE).map((producto) => (
            <article class="product-card" data-slug={producto.slug}>
              <a
                class="product-card__cover-link"
                href={`${base}${categoria}/${subcategoria}/${producto.slug}`}
                aria-label={`Ver detalles de ${producto.nombre}`}
              ></a>
              <div class="product-card__visual">
                <img src={producto.foto || `${base}assets/images/products/placeholder.webp`} alt={producto.nombre} loading="lazy" />
              </div>
              <div class="product-card__content">
                <span class="product-card__category">{producto.subcategoria}</span>
                <span class="product-card__availability"><strong>Disponibilidad:</strong> {producto.disponibilidad ?? 'Por confirmar'}</span>
                <h3>{producto.nombre}</h3>
                <dl class="product-card__details">
                  <div><dt>Marca</dt><dd>{producto.marca}</dd></div>
                  <div><dt>Referencia</dt><dd>{producto.referencia || 'Por confirmar'}</dd></div>
                  <div><dt>Aplicación</dt><dd>{(producto.aplicaciones || []).join(', ') || 'Por confirmar'}</dd></div>
                </dl>
                <p class="product-card__description">{producto.descripcion}</p>
                <a
                  class="product-card__cta"
                  href={`https://wa.me/573132416739?text=${encodeURIComponent(`Hola CaterTrack, quiero cotizar ${producto.nombre}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Solicitar cotización
                  <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </article>
          ))}
        </div>
        {items.length > PAGE_SIZE && (
          <button type="button" id="load-more-btn" class="catalog-load-more">
            Cargar más productos
          </button>
        )}
        <noscript>
          <p class="catalog-noscript">Activa JavaScript para ver el catálogo completo y buscar por máquina o referencia, o contáctanos por WhatsApp.</p>
        </noscript>
      </div>
    </section>
  </main>

  <Fragment slot="scripts">
    <script
      is:inline
      define:vars={{
        catalogItems: items.map((p) => ({
          slug: p.slug,
          nombre: p.nombre,
          marca: p.marca,
          referencia: p.referencia || '',
          aplicaciones: p.aplicaciones || [],
          descripcion: p.descripcion,
          foto: p.foto || '',
          disponibilidad: p.disponibilidad ?? null,
          categoria: p.categoria,
          subcategoria: p.subcategoria,
        })),
      }}
    >
      window.__catalogItems = catalogItems;
    </script>
    <script is:inline src={`${base}js/machine-filter.js`}></script>
  </Fragment>
</CatalogLayout>
