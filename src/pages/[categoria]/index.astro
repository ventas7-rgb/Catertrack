---
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import MachineSearch from '../../components/MachineSearch.astro';
import BrandFilter from '../../components/BrandFilter.astro';
import SubcategorySelectFilter from '../../components/SubcategorySelectFilter.astro';
import { categorias, productos } from '../../data/catalogo';
import { base } from '../../utils/base';
import { toMetaDescription } from '../../utils/seo';

export function getStaticPaths() {
  return categorias.map((categoria) => ({ params: { categoria: categoria.slug } }));
}

const { categoria } = Astro.params;
const categoriaData = categorias.find((item) => item.slug === categoria);
const items = productos.filter((producto) => producto.categoria === categoria);

// Marcas de equipo (CAT, Komatsu...) presentes en esta categoría, para el
// selector de BrandFilter — ver el comentario de ese componente sobre por
// qué solo aparece cuando hay más de una.
const marcasDisponibles = items.flatMap((producto) => producto.marcasEquipo || []);

// Con catálogos grandes, meter TODAS las tarjetas de una categoría en el HTML
// de una sola vez vuelve la página pesadísima (ver revisión de arquitectura:
// una sola subcategoría con 367 productos ya pesaba 553 KB solo en tarjetas).
// Por eso solo se renderizan de una las primeras PAGE_SIZE como HTML real
// (rápidas de cargar, visibles sin JavaScript, buenas para SEO) y el resto se
// entrega como datos (más abajo, `catalogItems`) para que
// public/js/machine-filter.js las agregue bajo demanda con el botón "Cargar
// más" — y para que el buscador por máquina/referencia siga encontrando
// cualquier producto de la categoría, no solo los ya cargados en pantalla.
const PAGE_SIZE = 24;

// Antes esta página no tenía meta description (el prop simplemente no se
// pasaba), así que Google se inventaba el resumen a partir de lo primero que
// encontrara en el HTML. Con una categoría completa a punto de crecer mucho
// (más marcas, más referencias), vale la pena darle un resumen propio.
const categoryDescription = categoriaData
  ? toMetaDescription(
      `Repuestos de ${categoriaData.nombre} para maquinaria pesada: ${items.length} referencias disponibles. Cotiza por WhatsApp con CaterTrack.`
    )
  : undefined;
---

<CatalogLayout title={`${categoriaData ? categoriaData.nombre : 'Categoría'} | CaterTrack`} description={categoryDescription} activeCategoria={categoria}>
  <main id="main-content" aria-label={`Catálogo de ${categoriaData?.nombre ?? 'categoría'}`}>
    <section class="catalog-products">
      <div class="container">
        <div class="catalog-section-heading">
          <div>
            <span class="catalog-hero__eyebrow">Explora por componente</span>
            <h2>Encuentra el repuesto que necesitas</h2>
          </div>
          <span class="catalog-result">{items.length} productos disponibles</span>
        </div>

        <div class="catalog-filters">
          <MachineSearch tipo={categoriaData?.buscarPor ?? 'maquina'} />
          <div class="catalog-filters-row">
            {categoriaData && <SubcategorySelectFilter subcategorias={categoriaData.subcategorias} />}
            <BrandFilter marcas={marcasDisponibles} />
          </div>
        </div>

        <div id="product-grid" class="product-grid" data-base={base} data-page-size={PAGE_SIZE}>
          {items.slice(0, PAGE_SIZE).map((producto) => (
            <article class="product-card" data-slug={producto.slug}>
              <a
                class="product-card__cover-link"
                href={`${base}${categoria}/${producto.subcategoria}/${producto.slug}`}
                aria-label={`Ver detalles de ${producto.nombre}`}
              ></a>
              <div class="product-card__visual">
                <img src={producto.foto || `${base}assets/images/products/placeholder.webp`} alt={producto.nombre} loading="lazy" />
              </div>
              <div class="product-card__content">
                <span class="product-card__category">{producto.subcategoria}</span>
                <span class="product-card__availability"><strong>Disponibilidad:</strong> {producto.disponibilidad ?? 'Por confirmar'}</span>
                <h3>{producto.nombre}</h3>
                <dl class="product-card__details">
                  <div><dt>Marca</dt><dd>{producto.marca}</dd></div>
                  {(producto.marcasEquipo || []).length > 0 && (
                    <div><dt>Marca de equipo</dt><dd>{producto.marcasEquipo.join(', ')}</dd></div>
                  )}
                  <div><dt>Referencia</dt><dd>{producto.referencia || 'Por confirmar'}</dd></div>
                  <div><dt>Aplicación</dt><dd>{(producto.aplicaciones || []).join(', ') || 'Por confirmar'}</dd></div>
                </dl>
                <p class="product-card__description">{producto.descripcion}</p>
                <a class="product-card__cta" href={`https://wa.me/573132416739?text=${encodeURIComponent(`Hola CaterTrack, quiero cotizar ${producto.nombre}`)}`} target="_blank" rel="noopener noreferrer">
                  Solicitar cotización
                  <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </article>
          ))}
        </div>
        {items.length > PAGE_SIZE && (
          <button type="button" id="load-more-btn" class="catalog-load-more">
            Cargar más productos
          </button>
        )}
        <noscript>
          <p class="catalog-noscript">Activa JavaScript para ver el catálogo completo y buscar por máquina o referencia, o contáctanos por WhatsApp.</p>
        </noscript>
      </div>
    </section>
  </main>

  <Fragment slot="scripts">
    <script
      is:inline
      define:vars={{
        catalogItems: items.map((p) => ({
          slug: p.slug,
          nombre: p.nombre,
          marca: p.marca,
          marcasEquipo: p.marcasEquipo || [],
          referencia: p.referencia || '',
          aplicaciones: p.aplicaciones || [],
          descripcion: p.descripcion,
          foto: p.foto || '',
          disponibilidad: p.disponibilidad ?? null,
          categoria: p.categoria,
          subcategoria: p.subcategoria,
        })),
      }}
    >
      window.__catalogItems = catalogItems;
    </script>
    <script is:inline src={`${base}js/machine-filter.js`}></script>
  </Fragment>
</CatalogLayout>
