---
// Cajita para filtrar, dentro de un listado ya renderizado, los productos
// que aplican a una máquina o a un motor específico (ej: "CAT 320" o
// "Cummins 6BT", según la categoría — ver `buscarPor` en catalogo.js), o
// que coinciden por código de referencia (ej: "9W9353"). El filtrado ocurre
// en el navegador — ver public/js/machine-filter.js. Este componente solo
// pinta el input y el mensaje de "sin resultados".

interface Props {
  tipo?: 'maquina' | 'motor';
}

const { tipo = 'maquina' } = Astro.props;

// El mensaje de "vacío" también se usa cuando el filtro de marca (ver
// BrandFilter.astro) no encuentra resultados, no solo la búsqueda de texto —
// por eso queda redactado en términos genéricos ("esos filtros") en vez de
// mencionar solo máquina/referencia.
const textos = {
  maquina: {
    label: 'Buscar por máquina o referencia',
    placeholder: 'Ej: CAT 320, Komatsu PC200, 9W9353...',
    vacio: 'No encontramos productos con esos filtros. Verifica los datos o contáctanos por WhatsApp.',
  },
  motor: {
    label: 'Buscar por motor o referencia',
    placeholder: 'Ej: Cummins 6BT, CAT 3306, Perkins, 9W9353...',
    vacio: 'No encontramos productos con esos filtros. Verifica los datos o contáctanos por WhatsApp.',
  },
};

const copy = textos[tipo] ?? textos.maquina;
---

<div class="machine-search">
  <label for="machine-search-input" class="machine-search__label">
    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
    {copy.label}
  </label>
  <input
    type="search"
    id="machine-search-input"
    class="machine-search__input"
    placeholder={copy.placeholder}
    autocomplete="off"
    aria-describedby="machine-search-empty"
  />
  <p class="machine-search__empty" id="machine-search-empty" hidden>
    {copy.vacio}
  </p>
</div>
