---
// Selector desplegable para filtrar, dentro de un listado ya renderizado,
// los productos por marca de equipo (CAT, Komatsu, Case, Shantui...) — ver
// el campo `marcasEquipo` en src/data/catalogo.js. Es un filtro adicional al
// buscador libre de MachineSearch.astro: ambos se combinan en el navegador
// (ver public/js/machine-filter.js), no son excluyentes.
//
// Se muestra siempre, en todas las categorías, aunque todavía no tengan
// marcas de equipo cargadas en sus productos (en ese caso el selector solo
// trae la opción "Todas las marcas") — así la barra de filtros es idéntica
// en todas las categorías y no "aparece y desaparece" a medida que se va
// completando el catálogo.

interface Props {
  marcas: string[];
}

const { marcas } = Astro.props;
const marcasOrdenadas = [...new Set(marcas)].sort((a, b) => a.localeCompare(b, 'es'));
---

<div class="brand-filter">
  <label for="brand-filter-select" class="brand-filter__label">
    <i class="fa-solid fa-industry" aria-hidden="true"></i>
    Filtrar por marca
  </label>
  <select id="brand-filter-select" class="brand-filter__select">
    <option value="">Todas las marcas</option>
    {marcasOrdenadas.map((marca) => (
      <option value={marca}>{marca}</option>
    ))}
  </select>
</div>
