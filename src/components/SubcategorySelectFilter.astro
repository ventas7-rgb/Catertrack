---
// Selector desplegable para filtrar, dentro de un listado ya renderizado,
// los productos por subcategoría (cadena, oruga, tejas...) — mismo patrón
// que BrandFilter.astro (selector + combinación en el navegador), pero para
// el campo `subcategoria` en vez de `marcasEquipo`. Se combina con AND junto
// al buscador de MachineSearch.astro y el selector de marca de
// BrandFilter.astro — ver public/js/machine-filter.js.
//
// Al igual que BrandFilter, se muestra siempre en todas las categorías — la
// lista de subcategorías sale directo de `categoriaData.subcategorias` en
// catalogo.js (es fija para la categoría, no depende de qué productos
// existan todavía) y no queda condicionada a que haya 2+ opciones, para que
// la barra de filtros sea idéntica en todas las categorías.
//
// Solo se usa en la página de CATEGORÍA (src/pages/[categoria]/index.astro),
// donde conviven productos de varias subcategorías a la vez. No se agrega a
// la página de una subcategoría puntual: ahí `window.__catalogItems` solo
// trae los productos de esa subcategoría, así que no habría con qué llenar
// las demás opciones. Para moverse entre páginas de subcategoría se sigue
// usando SubcategoryFilters.astro (los links/pills que ya existían, con su
// propia URL por subcategoría — importantes para SEO); este selector no los
// reemplaza, es un filtro adicional para no perder los demás filtros ni
// recargar la página.

interface Props {
  subcategorias: { slug: string; nombre: string }[];
}

const { subcategorias } = Astro.props;
---

<div class="subcategory-select-filter">
  <label for="subcategory-filter-select" class="subcategory-select-filter__label">
    <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
    Filtrar por subcategoría
  </label>
  <select id="subcategory-filter-select" class="subcategory-select-filter__select">
    <option value="">Todas las subcategorías</option>
    {subcategorias.map((subcategoria) => (
      <option value={subcategoria.slug}>{subcategoria.nombre}</option>
    ))}
  </select>
</div>
