---
// Selector desplegable de subcategoría — mismo patrón visual que
// BrandFilter.astro, pero se usa en dos modos distintos según la página:
//
// 1) Modo "filter" (página de CATEGORÍA, src/pages/[categoria]/index.astro):
//    ahí conviven productos de varias subcategorías a la vez, así que el
//    selector filtra en el navegador — se combina con AND junto al buscador
//    de MachineSearch.astro y el selector de marca de BrandFilter.astro (ver
//    public/js/machine-filter.js). Se activa no pasando `categoriaSlug`.
//
// 2) Modo "navigate" (página de SUBCATEGORÍA,
//    src/pages/[categoria]/[subcategoria]/index.astro): ahí
//    `window.__catalogItems` solo trae los productos de ESA subcategoría, así
//    que filtrar en el navegador no serviría para nada si se elige otra — en
//    vez de eso, al cambiar de opción el selector navega de una a la URL real
//    de la subcategoría elegida (o a la página de categoría si se elige
//    "Todas"). Se activa pasando `categoriaSlug` (y opcionalmente
//    `activeSlug` para dejar preseleccionada la subcategoría actual). Ese
//    cambio de página, además, conserva el valor SEO que tenían los antiguos
//    links/pills de SubcategoryFilters.astro (ya no se usan): cada opción
//    sigue siendo una URL real por subcategoría.
//
// Se muestra siempre, en todas las categorías, aunque todavía no tengan más
// de una subcategoría — así la barra de filtros es idéntica en todas partes.

interface Props {
  subcategorias: { slug: string; nombre: string }[];
  categoriaSlug?: string;
  activeSlug?: string;
}

const { subcategorias, categoriaSlug, activeSlug } = Astro.props;
---

<div class="subcategory-select-filter">
  <label for="subcategory-filter-select" class="subcategory-select-filter__label">
    <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
    Filtrar por subcategoría
  </label>
  <select
    id="subcategory-filter-select"
    class="subcategory-select-filter__select"
    data-mode={categoriaSlug ? 'navigate' : 'filter'}
    data-categoria={categoriaSlug}
  >
    <option value="" selected={!activeSlug}>Todas las subcategorías</option>
    {subcategorias.map((subcategoria) => (
      <option value={subcategoria.slug} selected={subcategoria.slug === activeSlug}>{subcategoria.nombre}</option>
    ))}
  </select>
</div>
